{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open-Skoob",
  "version": "0.1.0",
  "identifier": "com.skoob.openskoob",
  "build": {
    "beforeBuildCommand": "npm run build && node scripts/prepare-desktop.mjs",
    "beforeDevCommand": "npm run build && node scripts/prepare-desktop.mjs",
    "frontendDist": "bootstrap"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "resources/": "resources/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
