# Node.js 22.13+; Node.js 24 LTS recommended.
# Local startup needs no password. Connect an official Key in the browser, or skip.
# PORT=9002
# HOST=127.0.0.1
# SKOOB_DATA_DIR=./data
# Optional official engine connection. Never use a VITE_ prefix for secrets.
# SKOOB_CLOUD_URL=https://skoob.cc
# SKOOB_CLOUD_API_KEY=
# SKOOB_CLOUD_USER_ID=
# For a protected reverse proxy, explicitly allow its origin.
# SKOOB_ALLOWED_ORIGINS=https://your-private-workspace.example
