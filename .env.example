# Node.js 22.13+; Node.js 24 LTS recommended.
# Leave unset to generate a password and print it on first startup.
# SKOOB_LOCAL_PASSWORD=replace-with-your-own-long-password
# PORT=9002
# HOST=127.0.0.1
# SKOOB_DATA_DIR=./data
# Optional official engine connection. Never use a VITE_ prefix for secrets.
# SKOOB_CLOUD_URL=https://skoob.cc
# SKOOB_CLOUD_API_KEY=
# SKOOB_CLOUD_USER_ID=
